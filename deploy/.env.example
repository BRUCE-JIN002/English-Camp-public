# For automatic random database/storage passwords use: node deploy/prepare-env.mjs
# If copying this file manually, replace both placeholders before starting services.
POSTGRES_PASSWORD=REPLACE_WITH_A_RANDOM_DATABASE_PASSWORD
MINIO_ROOT_PASSWORD=REPLACE_WITH_A_RANDOM_STORAGE_PASSWORD
PUBLIC_BASE_URL=https://example.com
WEB_BASE=/english/
WEB_BIND=127.0.0.1
WEB_PORT=18082
